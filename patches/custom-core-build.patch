diff --git a/embed-prx.py b/embed-prx.py
new file mode 100644
index 0000000..ca5586a
--- /dev/null
+++ b/embed-prx.py
@@ -0,0 +1,9 @@
+"""Emit the embedded kernel bridge with platform-independent symbol names."""
+from pathlib import Path
+import sys
+data = Path(sys.argv[1]).read_bytes()
+rows = [", ".join(f"0x{b:02x}" for b in data[i:i + 16]) for i in range(0, len(data), 16)]
+Path(sys.argv[2]).write_text(
+    "unsigned char embedded_kcall[] = {\n" +
+    ",\n".join(rows) + "\n};\n" +
+    f"unsigned int embedded_kcall_len = {len(data)};\n", encoding="utf-8")
