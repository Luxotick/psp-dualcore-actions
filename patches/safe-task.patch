+// A single observation: never manufacture readiness or change interrupt state.
+static int pollMeReady(void* unused) {
+  (void)unused;
+  sceKernelDcacheInvalidateRange(_ME_SHARED_MEM, sizeof _ME_SHARED_MEM);
+  asm volatile("sync" ::: "memory");
+  return !(ME_PROCESSING & ME_PROCESSES);
+}
+
+int meSafeTaskWaitReadyTimeout(u32 timeoutUs) {
+  const u32 started = sceKernelGetSystemTimeLow();
+  for (;;) {
+    const int ready = meSafeTaskCall(pollMeReady, NULL);
+    if (ready < 0) return ready;
+    if (ready) return 0;
+    if ((u32)(sceKernelGetSystemTimeLow() - started) >= timeoutUs) return -110;
+    sceKernelDelayThread(1000);
+  }
+}
+
+// Restore on ME so its instruction cache also observes the original code.
+// The active wrapper returns to the unchanged part of the firmware handler.
+static void restoreMeCore(void* unused) {
+  (void)unused;
+  const u32 intr = meCoreInterruptClearMask();
+  const u32 sites[3] = { EDRAM_ROUTINE_PATCH_ADDR,
+    SYSCALL_ROUTINE_PATCH_ADDR, INTERRUPT_HANDLER_PATCH_ADDR };
+  meCoreDcacheInvalidateRange(savedPatches, sizeof savedPatches);
+  for (int i = 0; i < 3; ++i) {
+    hw(sites[i]) = savedPatches[i * 2];
+    hw(sites[i] + 4) = savedPatches[i * 2 + 1];
+    meCoreDcacheWritebackRange((void*)(sites[i] & ~63u), 64);
+  }
+  asm volatile("sync" ::: "memory");
+  meSafeIcacheInvalidateAll();
+  meCoreInterruptSetMask(intr);
+}
+
+static int finishRestore(void* unused) {
+  (void)unused;
+  // ME restored system RAM; discard stale SC copies before future patching.
+  sceKernelDcacheInvalidateRange((void*)(EDRAM_ROUTINE_PATCH_ADDR & ~63u), 64);
+  sceKernelDcacheInvalidateRange((void*)(SYSCALL_ROUTINE_PATCH_ADDR & ~63u), 64);
+  sceKernelDcacheInvalidateRange((void*)(INTERRUPT_HANDLER_PATCH_ADDR & ~63u), 64);
+  dispatcherPatched = 0;
+  return 0;
+}
+
+int meSafeTaskShutdownDispatcher(u32 timeoutUs) {
+  int ret = meSafeTaskWaitReadyTimeout(timeoutUs);
+  if (ret < 0) return ret;
+  Task cleanup = { restoreMeCore, NULL, 0 };
+  ret = meSafeTaskDispatch(&cleanup);
+  if (ret < 0) return ret;
+  ret = meSafeTaskWaitReadyTimeout(timeoutUs);
+  if (ret < 0) return ret;
+  return meSafeTaskCall(finishRestore, NULL);
+}
