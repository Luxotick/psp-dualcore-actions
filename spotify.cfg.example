# PSPotify ME configuration: ms0:/PSP/GAME/PSPOTIFY/spotify.cfg
#
# You normally never write this file yourself. On first start the PSP shows
# a code to enter at spotify.com/pair and then creates this file. It holds
# credentials in plain text: keep the Memory Stick safe.

# Canonical Spotify username (filled in after the first login)
username =

# OAuth refresh token from pairing; renews sign-in silently
refresh_token =

# Reusable credentials issued by Spotify after login (hex), and the client
# they belong to
blob_client =
blob =

# Optional, instead of pairing: a Spotify access token for the first login.
# Tokens copied from the web player are not accepted by every service, so
# pairing is preferred.
token =
